{
  "name": "@anishfyi/troy-advanced",
  "version": "0.1.0",
  "description": "Terminal-native, EC2-ready, ASCII-rendered agent browser with full Troy Agent Socket compatibility, headless Chromium CDP + zero-Chrome lite engine, MCP server, and streaming AI pipe.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ascii": {
      "types": "./dist/ascii/index.d.ts",
      "import": "./dist/ascii/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./pipe": {
      "types": "./dist/pipe/index.d.ts",
      "import": "./dist/pipe/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud/index.d.ts",
      "import": "./dist/cloud/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "troy-advanced": "./bin/troy-advanced.mjs",
    "troya": "./bin/troy-advanced.mjs"
  },
  "files": [
    "bin",
    "dist",
    "deploy",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ./scripts/lint.mjs",
    "lint:json": "node ./scripts/lint.mjs --json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/chromium-e2e.test.ts",
    "test:e2e:chrome": "TROY_REQUIRE_CHROME=1 vitest run test/chromium-e2e.test.ts",
    "test:watch": "vitest",
    "bench": "node ./bin/troy-advanced.mjs bench",
    "bench:ascii": "npm run build && node ./scripts/bench-ascii.mjs",
    "demo": "npm run build && node ./scripts/demo-site.mjs",
    "doctor": "node ./bin/troy-advanced.mjs doctor",
    "daemon": "node ./bin/troy-advanced.mjs daemon start",
    "browse": "node ./bin/troy-advanced.mjs browse",
    "mcp": "node ./bin/troy-advanced.mjs mcp",
    "pipe": "node ./bin/troy-advanced.mjs pipe"
  },
  "keywords": [
    "browser",
    "ai-agent",
    "ascii",
    "terminal",
    "ec2",
    "headless",
    "cdp",
    "mcp",
    "troy",
    "automation"
  ],
  "author": "Anish Kumar <anishfyi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishfyi/troy-advanced.git"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
