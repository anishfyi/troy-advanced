# Environment variables for `docker compose up -d` EC2 deployment.
# Copy to `.env` in the repository root and customize as needed.

# Container image tag and name
TROY_IMAGE=troy-advanced:latest
TROY_CONTAINER_NAME=troy-advanced

# Loopback Agent Socket port (bound strictly to 127.0.0.1 on the EC2 host)
TROY_AGENT_PORT=9333

# Browser engine: auto | chromium | lite
TROY_ENGINE=auto

# Safety policy profile: strict | standard | permissive
TROY_POLICY=standard

# Shared memory size for Chromium renderer processes
TROY_SHM_SIZE=1gb

# Container timezone
TZ=UTC
